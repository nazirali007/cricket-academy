# Copy to .env.local for local development, and add them to your hosting
# provider's environment settings. Never commit the real values.

# Postgres connection string. The site creates its own tables on first connect.
# Supabase: Project > Connect > "Transaction pooler" (port 6543), with your
# database password filled in. Don't use the "Direct connection" link: it only
# works over IPv6, which most hosts (including Vercel) don't support.
DATABASE_URL=
# Optional, Supabase: paste the certificate from Database > Settings > SSL
# (put \n for line breaks) to fully verify the database server.
# DATABASE_CA_CERT=

# The single admin account for /admin (bookings, admissions, refunds, CSV
# downloads). There is no sign-up: this user ID and password are the only way
# in. Changing either one signs out every device.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random text that signs admin sessions. Changing it also signs out every
# device. Generate one with: openssl rand -base64 36
ADMIN_SESSION_SECRET=

# Razorpay keys, from Dashboard > Account & Settings > API Keys. Use test keys
# until you're ready to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in Dashboard > Webhooks. Point it
# at https://www.ccsacademylucknow.com/api/razorpay/webhook with the events
# payment.captured, order.paid, payment_link.paid, refund.processed and
# refund.failed.
RAZORPAY_WEBHOOK_SECRET=

# Long random text that lets the scheduler send due payment links by calling
# /api/cron/payment-links with "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional: emails the academy about each new booking. Use the outgoing mail
# (SMTP) settings for the mailbox. For Gmail: SMTP_HOST=smtp.gmail.com, and
# SMTP_PASSWORD must be a Google "App password" (Google Account > Security >
# 2-Step Verification > App passwords), not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ccsacademylucknow@gmail.com
SMTP_PASSWORD=
# Where alerts go. Defaults to the academy's contact email.
BOOKING_EMAIL_TO=ccsacademylucknow@gmail.com
