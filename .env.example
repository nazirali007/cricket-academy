# Copy to .env.local for local development, and add them to your hosting
# provider's environment settings. Never commit the real values.

# Postgres connection string, from Neon, Supabase or any Postgres host.
DATABASE_URL=

# Password for the bookings admin page at /admin/bookings. Use a long one.
ADMIN_PASSWORD=

# Optional: emails the academy about each new booking. Use the outgoing mail
# (SMTP) settings for the mailbox, from your email or domain provider.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contact@ccsacademylucknow.com
SMTP_PASSWORD=
# Where alerts go. Defaults to the academy's contact email.
BOOKING_EMAIL_TO=
