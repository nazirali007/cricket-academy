# Copy to .env.local for local development, and add them to your hosting
# provider's environment settings. Never commit the real values.

# Postgres connection string, from Neon, Supabase or any Postgres host.
DATABASE_URL=

# Password for the bookings admin page at /admin/bookings. Use a long one.
ADMIN_PASSWORD=

# Razorpay keys, from Dashboard > Account & Settings > API Keys. Use test keys
# until you're ready to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in Dashboard > Webhooks. Point it
# at https://www.ccsacademylucknow.com/api/razorpay/webhook with the events
# payment.captured and order.paid.
RAZORPAY_WEBHOOK_SECRET=

# Optional: emails the academy about each new booking. Use the outgoing mail
# (SMTP) settings for the mailbox, from your email or domain provider.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contact@ccsacademylucknow.com
SMTP_PASSWORD=
# Where alerts go. Defaults to the academy's contact email.
BOOKING_EMAIL_TO=

# Testing only. With no database or Razorpay keys, "pnpm dev" shows a test
# mode with a dummy payment window. Setting this to true does the same on a
# deployed site. Never set it on the live site.
# BOOKING_DEMO=true
