# Copy to .env.local for local development, and add them to your hosting
# provider's environment settings. Never commit the real values.

# Postgres connection string. Neon (neon.tech) has a free plan that's plenty
# for this site. The site creates its own tables on first connect.
DATABASE_URL=

# Password for the admin dashboard at /admin (bookings, admissions, students,
# CSV downloads). Use a long one, and share it only with academy staff.
ADMIN_PASSWORD=

# Razorpay keys, from Dashboard > Account & Settings > API Keys. Use test keys
# until you're ready to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in Dashboard > Webhooks. Point it
# at https://www.ccsacademylucknow.com/api/razorpay/webhook with the events
# payment.captured, order.paid, refund.processed and refund.failed.
RAZORPAY_WEBHOOK_SECRET=

# Optional: emails the academy about each new booking. Use the outgoing mail
# (SMTP) settings for the mailbox. For Gmail: SMTP_HOST=smtp.gmail.com, and
# SMTP_PASSWORD must be a Google "App password" (Google Account > Security >
# 2-Step Verification > App passwords), not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ccsacademylucknow@gmail.com
SMTP_PASSWORD=
# Where alerts go. Defaults to the academy's contact email.
BOOKING_EMAIL_TO=
